# Server Configuration
PORT=8080

# Database Configuration
# For local development with docker-compose:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/psych_appointments?sslmode=disable

# For Railway deployment, use the DATABASE_URL provided by Railway (it will override this)
# DATABASE_URL=postgres://user:password@host:port/database

# External identity provider. AUTH_ISSUER must match the issuer configured in Auth.
AUTH_SERVICE_URL=https://auth-service-production-8529.up.railway.app
AUTH_ISSUER=https://auth-service-production-8529.up.railway.app
# Exact frontend origin (no trailing path); required for browser CORS.
FRONTEND_URL=http://localhost:5173
# Only disable Secure for local HTTP development.
AUTH_COOKIE_SECURE=false

# WhatsApp Configuration (Evolution API)
# Set WHATSAPP_MODE to "mock" for development without Evolution API
# Set WHATSAPP_MODE to "evolution" for production with real WhatsApp sending
WHATSAPP_MODE=mock

# Evolution API Configuration (only needed if WHATSAPP_MODE=evolution)
EVOLUTION_API_URL=https://your-evolution-api-url.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=your-instance-name

